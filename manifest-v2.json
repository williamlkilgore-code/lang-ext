{
  "manifest_version": 2,
  "name": "Language Learner - Farsi, Chinese & Russian",
  "version": "2.2.0",
  "description": "Learn Persian/Farsi, Chinese, and Russian by discovering roots, radicals, and character meanings in context",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "options_page": "options/options.html",
  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Toggle Language Learner on/off for current page"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/settings.js",
        "utils/vocabulary-manager.js",
        "utils/language-detector.js",
        "utils/persian-matcher.js",
        "utils/chinese-detector.js",
        "utils/chinese-matcher.js",
        "utils/russian-detector.js",
        "utils/russian-affixes.js",
        "utils/russian-matcher.js",
        "content/translation-popup.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background/background-v2.js"],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    "data/farsi-roots.json",
    "data/chinese-hsk.json",
    "data/russian-roots.json"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "language-learner@example.com",
      "strict_min_version": "57.0"
    }
  }
}
